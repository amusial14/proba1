    "query_maintenance = \"\"\"\n",
    "SELECT \n",
    "    a.attraction_name,\n",
    "    COUNT(m.malfunction_id) as liczba_awarii,\n",
    "    SUM(m.fix_cost) as laczny_koszt_napraw\n",
    "FROM attractions a\n",
    "JOIN malfunctions m ON a.attraction_id = m.attraction_id\n",
    "GROUP BY a.attraction_name\n",
    "ORDER BY laczny_koszt_napraw DESC\n",
    "LIMIT 10\n",
    "\"\"\"\n",
    "\n",
    "try:\n",
